# ── Secrets ────────────────────────────────────────────────────────
.env
*.key
*.pem

# ── Operational data ───────────────────────────────────────────────
# Large caches and logs: ignore
data/cache/
data/trends/
data/metrics_db.json
data/db/
logs/
insta-brain/inbox.md

# Ledgers: TRACK in git so GitHub Actions can read/write state
# across runs without an external store.
# data/approval_queue.jsonl  <- tracked
# insta-brain/data/*.jsonl   <- tracked
# insta-brain/log.md         <- tracked
# insta-brain/MEMORY_INDEX.md <- tracked

# Ephemeral/local logs only
data/launchd_publish.log
data/launchd_publish.err

# ── Large generated assets ─────────────────────────────────────────
# assets/video/ is 466MB footage pool, too large for git
assets/video/
assets/avatars/
# Music files > 50MB (GitHub hard limit is 100MB, recommended 50MB)
# These two albums exceed the limit -- keep locally only
"assets/music/Epic Motivational and Cinematic Inspirational Music*"
"assets/music/River of Emotions*"

# Music and intro tracked in git so GitHub Actions has them
# assets/music/default.mp3  <- tracked
# assets/intros/factjot_intro.mov  <- tracked

# ── Python ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/

# ── Claude Code local session data ────────────────────────────────
.claude/

# ── macOS ──────────────────────────────────────────────────────────
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride

# ── Windows ────────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Env variants ───────────────────────────────────────────────────
.env.local
.env.*.local

# ── Local preview output ───────────────────────────────────────────
# All pipeline dry-run previews live here locally -- never committed
output/
# Legacy test output (also excluded)
tests/output/
experiments/*/output/
# Lock files
.make_reel.lock

# ── Brand reference docs (kept locally, never committed) ──────────
# No leading slash = matches at any depth, so root-level
# `style-guide-v2.pdf` is also covered.
style-guide-*.pdf

# ── Loose log / temp files ─────────────────────────────────────────
*.log
*.tmp
*.swp
*.swo
.coverage
