# insta-brain/data/*.jsonl   <- tracked
# insta-brain/log.md         <- tracked
# insta-brain/MEMORY_INDEX.md <- tracked

# Still ignore large/ephemeral ledgers
data/ledgers/used_images.jsonl
data/launchd_publish.log
data/launchd_publish.err

