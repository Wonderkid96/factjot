<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tjcreate.factjot.plan_week</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Library/Frameworks/Python.framework/Versions/Current/bin/python3</string>
    <string>/Users/Music/Documents/Insta-bot/scripts/plan_week.py</string>
    <string>--days</string>
    <string>7</string>
    <string>--start-tomorrow</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/Music/Documents/Insta-bot</string>

  <!-- Sunday 04:00 local. After discovery has populated the feed, schedule
       Mon-Sun 10:00 + 18:00 for next 7 days (14 carousels). Idempotent. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>0</integer>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/Music/Documents/Insta-bot/data/launchd_plan_week.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/Music/Documents/Insta-bot/data/launchd_plan_week.err</string>
</dict>
</plist>
