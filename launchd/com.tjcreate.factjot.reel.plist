<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tjcreate.factjot.reel</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Library/Frameworks/Python.framework/Versions/Current/bin/python3</string>
    <string>/Users/Music/Documents/Insta-bot/scripts/make_reel.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/Music/Documents/Insta-bot</string>

  <!-- Daily at 19:00 UTC (8pm UK / 7pm UTC winter).
       Fires after the 18:00 carousel so the Reel doesn't clash.
       Picks next unused quirky_score=3 fact automatically.
       Generates video + thumbnail + story and posts all three. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>19</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/Music/Documents/Insta-bot/logs/reel.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/Music/Documents/Insta-bot/logs/reel.err</string>
</dict>
</plist>
