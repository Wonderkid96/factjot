<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tjcreate.factjot.refresh</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Library/Frameworks/Python.framework/Versions/Current/bin/python3</string>
    <string>/Users/Music/Documents/Insta-bot/scripts/refresh_token.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/Music/Documents/Insta-bot</string>

  <!-- Sunday 03:30 local. Token expires at ~60 days; weekly refresh keeps it alive. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>0</integer>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/Music/Documents/Insta-bot/data/launchd_refresh.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/Music/Documents/Insta-bot/data/launchd_refresh.err</string>
</dict>
</plist>
