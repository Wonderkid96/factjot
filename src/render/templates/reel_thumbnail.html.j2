<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<style>
  @font-face {
    font-family: "Instrument Serif";
    src: url("{{ font_serif_regular }}") format("truetype");
    font-weight: 400;
    font-style: normal;
  }
  @font-face {
    font-family: "Instrument Serif";
    src: url("{{ font_serif_italic }}") format("truetype");
    font-weight: 400;
    font-style: italic;
  }
  @font-face {
    font-family: "JetBrains Mono";
    src: url("{{ font_mono_bold }}") format("truetype");
    font-weight: 700;
    font-style: normal;
  }

  :root {
    --paper:     #F4F1E9;
    --ink:       #0A0A0A;
    --near-black:#0B0B0C;
    --off-white: #EDE8DD;
    --accent:    #E6352A;
    --lime:      #C8DB45;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  html, body {
    width: {{ width }}px;
    height: {{ height }}px;
    overflow: hidden;
    background: var(--near-black);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  /* ── Footage background ─────────────────────────────────────────── */
  .stage {
    position: relative;
    width: 100%;
    height: 100%;
    {% if frame_url %}
    background: url("{{ frame_url }}") center / cover no-repeat;
    {% else %}
    background: linear-gradient(160deg, #141416 0%, #0D0D0F 45%, #0A0A0B 100%);
    {% endif %}
  }

  /* ── Gradient stack ─────────────────────────────────────────────── */
  .grad-top {
    position: absolute;
    inset: 0 0 auto 0;
    height: 35%;
    background: linear-gradient(to bottom, rgba(0,0,0,0.78) 0%, rgba(0,0,0,0.00) 100%);
    z-index: 1;
    pointer-events: none;
  }
  .grad-bottom {
    position: absolute;
    inset: 32% 0 0 0;
    background: linear-gradient(
      to bottom,
      rgba(0,0,0,0.00)  0%,
      rgba(0,0,0,0.38) 35%,
      rgba(0,0,0,0.78) 65%,
      rgba(0,0,0,0.95) 100%
    );
    z-index: 1;
    pointer-events: none;
  }
  .grad-sides {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, rgba(0,0,0,0.00) 48%, rgba(0,0,0,0.45) 100%);
    z-index: 1;
    pointer-events: none;
  }

  /* ── Title scrim: localised darkening behind content group ─────── */
  .title-scrim {
    position: absolute;
    top: 22%;
    left: 0;
    right: 0;
    height: 55%;
    background: radial-gradient(ellipse 75% 55% at 50% 50%,
      rgba(0,0,0,0.60) 0%,
      rgba(0,0,0,0.00) 100%
    );
    z-index: 2;
    pointer-events: none;
  }

  /* ── Left accent line: full height, red → lime ──────────────────── */
  .accent-line {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    z-index: 3;
    background: linear-gradient(
      to bottom,
      transparent    0%,
      var(--accent)  18%,
      var(--lime)    55%,
      var(--accent)  82%,
      transparent   100%
    );
    opacity: 0.80;
  }

  /* ── Corner brackets: viewfinder aesthetic ──────────────────────── */
  .corners { position: absolute; inset: 0; z-index: 4; pointer-events: none; }
  .corner { position: absolute; width: 56px; height: 56px; }
  .corner::before, .corner::after {
    content: ""; position: absolute; background: var(--off-white); opacity: 0.65;
  }
  .corner::before { height: 3px; width: 100%; top: 0; left: 0; }
  .corner::after  { width:  3px; height: 100%; top: 0; left: 0; }
  .corner-tl { top: 48px;  left: 48px; }
  .corner-tr { top: 48px;  right: 48px; transform: scaleX(-1); }
  .corner-bl { bottom: 48px; left: 48px;  transform: scaleY(-1); }
  .corner-br { bottom: 48px; right: 48px; transform: scale(-1); }

  /* ── Content group: logo-bar + title, vertically centred ────────── */
  /* Width matches the title column so the lines terminate at the same  */
  /* horizontal edges as the text.                                      */
  .content-group {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -54%);
    width: 82%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 52px;
    z-index: 5;
  }

  /* ── Logo bar: [────] fact*jot*. [────] ─────────────────────────── */
  /* Lines extend flush to the edges of the content-group width,       */
  /* framing the wordmark symmetrically.                                */
  .logo-bar {
    display: flex;
    align-items: center;
    width: 100%;
    gap: 20px;
  }
  .logo-line {
    flex: 1 1 auto;
    height: 1px;
    background: var(--off-white);
    opacity: 0.45;
  }
  .logo-wordmark {
    font-family: "Instrument Serif", Georgia, serif;
    font-weight: 400;
    font-size: 140px;
    letter-spacing: -0.02em;
    color: var(--off-white);
    flex: 0 0 auto;
    white-space: nowrap;
    text-shadow: 2px 2px 0 rgba(0,0,0,0.65);
  }
  .logo-wordmark .reg  { font-style: normal; }
  .logo-wordmark .ital { font-style: italic; }
  .logo-wordmark .dot  { color: var(--accent); font-style: normal; }

  /* ── Title: Instrument Serif, centred under logo bar ───────────── */
  .title {
    width: 100%;
    font-family: "Instrument Serif", Georgia, serif;
    font-weight: 400;
    font-size: {{ title_size }}px;
    line-height: 1.06;
    letter-spacing: -0.020em;
    color: var(--off-white);
    text-align: center;
    text-wrap: balance;
    text-shadow:
      2px 2px 0 rgba(0,0,0,0.70),
      0 4px 18px rgba(0,0,0,0.60),
      0 8px 48px rgba(0,0,0,0.40);
  }
  .title em { font-style: italic; }
  .title .accent { color: var(--accent); font-style: italic; }

</style>
</head>
<body>
<div class="stage">

  <div class="grad-top"></div>
  <div class="grad-bottom"></div>
  <div class="grad-sides"></div>
  <div class="title-scrim"></div>
  <div class="accent-line"></div>

  <div class="corners">
    <div class="corner corner-tl"></div>
    <div class="corner corner-tr"></div>
    <div class="corner corner-bl"></div>
    <div class="corner corner-br"></div>
  </div>

  <div class="content-group">
    <div class="logo-bar">
      <div class="logo-line"></div>
      <span class="logo-wordmark">
        <span class="reg">fact</span><span class="ital">jot</span><span class="dot">.</span>
      </span>
      <div class="logo-line"></div>
    </div>
    <div class="title">{{ title_html | safe }}</div>
  </div>

</div>
</body>
</html>
