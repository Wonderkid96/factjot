<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<style>
  @font-face {
    font-family: "Instrument Serif";
    src: url("{{ font_serif_regular }}") format("truetype");
    font-weight: 400;
    font-style: normal;
  }
  @font-face {
    font-family: "Instrument Serif";
    src: url("{{ font_serif_italic }}") format("truetype");
    font-weight: 400;
    font-style: italic;
  }
  @font-face {
    font-family: "JetBrains Mono";
    src: url("{{ font_mono_bold }}") format("truetype");
    font-weight: 700;
    font-style: normal;
  }

  :root {
    --paper:     #F4F1E9;
    --ink:       #0A0A0A;
    --near-black:#0B0B0C;
    --off-white: #EDE8DD;
    --accent:    #E6352A;
    --lime:      #C8DB45;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  html, body {
    width: {{ width }}px;
    height: {{ height }}px;
    overflow: hidden;
    background: var(--near-black);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  .stage {
    position: relative;
    width: 100%;
    height: 100%;
    {% if frame_url %}
    background: url("{{ frame_url }}") center / cover no-repeat;
    {% else %}
    background: linear-gradient(160deg, #141416 0%, #0D0D0F 45%, #0A0A0B 100%);
    {% endif %}
  }

  /* Cinematic dark overlay — above footage frame, below all text and branding */
  .dark-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      rgba(0,0,0,0.62) 0%,
      rgba(0,0,0,0.28) 25%,
      rgba(0,0,0,0.22) 55%,
      rgba(0,0,0,0.72) 85%,
      rgba(0,0,0,0.88) 100%
    );
    pointer-events: none;
  }

  /* Accent gradient line — left edge, matches carousel style */
  .accent-line {
    position: absolute;
    left: 0;
    top: 15%;
    bottom: 15%;
    width: 3px;
    z-index: 2;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      var(--accent) 20%,
      var(--lime) 60%,
      transparent 100%
    );
    opacity: 0.7;
  }

  /* Header: factjot. [───────────] TOPIC — full width, carousel style */
  .header {
    position: absolute;
    top: 88px;
    left: 56px;
    right: 56px;
    display: flex;
    align-items: center;
    z-index: 2;
  }
  .header-wordmark {
    font-family: "Instrument Serif", Georgia, serif;
    font-weight: 400;
    font-size: 28px;
    letter-spacing: -0.02em;
    color: var(--off-white);
    opacity: 0.88;
    flex: 0 0 auto;
    white-space: nowrap;
    text-shadow: 1px 1px 0 rgba(0,0,0,0.5);
  }
  .header-wordmark .reg  { font-style: normal; }
  .header-wordmark .ital { font-style: italic; }
  .header-wordmark .dot  { color: var(--accent); }
  .header-sep {
    flex: 1 1 auto;
    height: 1px;
    background: var(--off-white);
    opacity: 0.25;
    margin: 0 16px;
  }
  .header-topic {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-weight: 700;
    font-size: 22px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--off-white);
    opacity: 0.88;
    flex: 0 0 auto;
    white-space: nowrap;
    text-shadow: 1px 1px 0 rgba(0,0,0,0.5);
  }

  /* Title — centred X and Y, large Instrument Serif */
  .title {
    position: absolute;
    top: 50%;
    left: 56px;
    right: 56px;
    transform: translateY(-50%);
    z-index: 2;
    font-family: "Instrument Serif", Georgia, serif;
    font-weight: 400;
    font-size: {{ title_size }}px;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--off-white);
    text-align: center;
    text-wrap: balance;
    text-shadow: 2px 2px 0 rgba(0,0,0,0.5);
  }
  .title em { font-style: italic; }
  .title .accent { color: var(--accent); font-style: italic; }

  /* Play icon — subtle cue that this is a video */
  .play-hint {
    position: absolute;
    bottom: 200px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    opacity: 0.55;
  }
  .play-circle {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    border: 2px solid var(--off-white);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .play-triangle {
    width: 0;
    height: 0;
    border-top: 16px solid transparent;
    border-bottom: 16px solid transparent;
    border-left: 26px solid var(--off-white);
    margin-left: 4px;
  }
  .play-label {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-weight: 700;
    font-size: 18px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--off-white);
  }
</style>
</head>
<body>
<div class="stage">
  <div class="dark-overlay"></div>
  <div class="accent-line"></div>

  <div class="header">
    <span class="header-wordmark">
      <span class="reg">fact</span><span class="ital">jot</span><span class="dot">.</span>
    </span>
    <span class="header-sep"></span>
    <span class="header-topic">{{ topic }}</span>
  </div>

  <div class="title">{{ title_html | safe }}</div>

  <div class="play-hint">
    <div class="play-circle">
      <div class="play-triangle"></div>
    </div>
    <span class="play-label">Watch</span>
  </div>
</div>
</body>
</html>
