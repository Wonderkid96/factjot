<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<style>
  @font-face {
    font-family: "Instrument Serif";
    src: url("{{ font_serif_regular }}") format("truetype");
    font-weight: 400;
    font-style: normal;
  }
  @font-face {
    font-family: "Instrument Serif";
    src: url("{{ font_serif_italic }}") format("truetype");
    font-weight: 400;
    font-style: italic;
  }
  @font-face {
    font-family: "JetBrains Mono";
    src: url("{{ font_mono_bold }}") format("truetype");
    font-weight: 700;
    font-style: normal;
  }

  :root {
    --near-black: #0B0B0C;
    --off-white:  #EDE8DD;
    --accent:     #E6352A;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  html, body {
    width: {{ width }}px;
    height: {{ height }}px;
    overflow: hidden;
    background: var(--near-black);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  /* ── Full-bleed footage frame (always present, even if dark) ─── */
  .stage {
    position: relative;
    width: 100%;
    height: 100%;
    {% if frame_url %}
    background: url("{{ frame_url }}") center / cover no-repeat;
    {% else %}
    background: linear-gradient(160deg, #1a1a1e 0%, #0D0D0F 50%, #0A0A0B 100%);
    {% endif %}
  }

  /* ── Heavy bottom gradient -- ensures title always legible ─── */
  .grad-bottom {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0,0,0,0.10) 0%,
      rgba(0,0,0,0.05) 20%,
      rgba(0,0,0,0.30) 42%,
      rgba(0,0,0,0.82) 62%,
      rgba(0,0,0,0.97) 78%,
      rgba(0,0,0,1.00) 100%
    );
    z-index: 1;
  }

  /* ── Subtle side vignette ───────────────────────────────────── */
  .vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center,
      rgba(0,0,0,0.00) 50%,
      rgba(0,0,0,0.45) 100%
    );
    z-index: 2;
    pointer-events: none;
  }

  /* ── Accent bar -- left edge, full height, always visible ───── */
  .accent-bar {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 7px;
    background: var(--accent);
    z-index: 10;
  }

  /* ── Header row: factjot. left, TOPIC right ─────────────────── */
  .header {
    position: absolute;
    top: 62px;
    left: 80px;
    right: 62px;
    display: flex;
    align-items: center;
    gap: 16px;
    z-index: 8;
  }
  .wordmark {
    font-family: "Instrument Serif", Georgia, serif;
    font-size: 32px;
    letter-spacing: -0.02em;
    color: var(--off-white);
    flex: 0 0 auto;
    text-shadow: 0 2px 12px rgba(0,0,0,0.8);
  }
  .wordmark .ital { font-style: italic; }
  .wordmark .dot  { color: var(--accent); }
  .divider {
    flex: 1;
    height: 1px;
    background: var(--off-white);
    opacity: 0.28;
  }
  .topic {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-weight: 700;
    font-size: 20px;
    letter-spacing: 0.20em;
    text-transform: uppercase;
    color: var(--off-white);
    flex: 0 0 auto;
    opacity: 0.75;
    text-shadow: 0 2px 8px rgba(0,0,0,0.8);
  }

  /* ── Title block -- anchored to bottom ──────────────────────── */
  .lower {
    position: absolute;
    left: 80px;
    right: 62px;
    bottom: 100px;
    z-index: 8;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  /* Red rule above the title */
  .rule {
    width: 72px;
    height: 4px;
    background: var(--accent);
    border-radius: 2px;
  }

  .title {
    font-family: "Instrument Serif", Georgia, serif;
    font-weight: 400;
    font-size: {{ title_size }}px;
    line-height: 1.05;
    letter-spacing: -0.022em;
    color: var(--off-white);
    text-wrap: balance;
    text-shadow:
      2px 3px 0   rgba(0,0,0,0.80),
      0   6px 24px rgba(0,0,0,0.55);
  }
  .title em { font-style: italic; color: var(--off-white); }

  /* ── Corner brackets (top-right only -- balances the accent bar) */
  .corner-tr {
    position: absolute;
    top: 48px;
    right: 48px;
    width: 48px;
    height: 48px;
    z-index: 8;
  }
  .corner-tr::before {
    content: "";
    position: absolute;
    top: 0; right: 0;
    width: 100%;
    height: 3px;
    background: var(--off-white);
    opacity: 0.55;
  }
  .corner-tr::after {
    content: "";
    position: absolute;
    top: 0; right: 0;
    width: 3px;
    height: 100%;
    background: var(--off-white);
    opacity: 0.55;
  }

  /* ── Bottom-right: factjot watermark ────────────────────────── */
  .watermark {
    position: absolute;
    right: 62px;
    bottom: 54px;
    z-index: 8;
    font-family: "Instrument Serif", serif;
    font-size: 24px;
    letter-spacing: -0.01em;
    color: var(--off-white);
    opacity: 0.40;
  }
  .watermark .ital { font-style: italic; }
  .watermark .dot  { color: var(--accent); opacity: 1; }

</style>
</head>
<body>
<div class="stage">

  <div class="grad-bottom"></div>
  <div class="vignette"></div>
  <div class="accent-bar"></div>

  <div class="header">
    <span class="wordmark">fact<span class="ital">jot</span><span class="dot">.</span></span>
    <span class="divider"></span>
    <span class="topic">{{ topic }}</span>
  </div>

  <div class="corner-tr"></div>

  <div class="lower">
    <div class="rule"></div>
    <div class="title">{{ title_html | safe }}</div>
  </div>

  <div class="watermark">fact<span class="ital">jot</span><span class="dot">.</span></div>

</div>
</body>
</html>
