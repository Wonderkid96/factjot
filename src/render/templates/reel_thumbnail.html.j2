<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<style>
  @font-face {
    font-family: "Instrument Serif";
    src: url("{{ font_serif_regular }}") format("truetype");
    font-weight: 400;
    font-style: normal;
  }
  @font-face {
    font-family: "Instrument Serif";
    src: url("{{ font_serif_italic }}") format("truetype");
    font-weight: 400;
    font-style: italic;
  }
  @font-face {
    font-family: "JetBrains Mono";
    src: url("{{ font_mono_bold }}") format("truetype");
    font-weight: 700;
    font-style: normal;
  }

  :root {
    --near-black: #0B0B0C;
    --off-white:  #EDE8DD;
    --accent:     #E6352A;
    --lime:       #C8DB45;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  html, body {
    width: {{ width }}px;
    height: {{ height }}px;
    overflow: hidden;
    background: var(--near-black);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  .stage {
    position: relative;
    width: 100%;
    height: 100%;
    {% if frame_url %}
    background: url("{{ frame_url }}") center / cover no-repeat;
    {% else %}
    background: linear-gradient(160deg, #141416 0%, #0D0D0F 45%, #0A0A0B 100%);
    {% endif %}
  }

  /* ── Gradient stack ─────────────────────────────────────────────── */
  .grad-top {
    position: absolute;
    inset: 0 0 auto 0;
    height: 35%;
    background: linear-gradient(to bottom, rgba(0,0,0,0.78) 0%, rgba(0,0,0,0.00) 100%);
    z-index: 1;
    pointer-events: none;
  }
  .grad-bottom {
    position: absolute;
    inset: 32% 0 0 0;
    background: linear-gradient(
      to bottom,
      rgba(0,0,0,0.00)  0%,
      rgba(0,0,0,0.38) 35%,
      rgba(0,0,0,0.78) 65%,
      rgba(0,0,0,0.95) 100%
    );
    z-index: 1;
    pointer-events: none;
  }
  .grad-sides {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, rgba(0,0,0,0.00) 48%, rgba(0,0,0,0.45) 100%);
    z-index: 1;
    pointer-events: none;
  }

  /* ── Title scrim ────────────────────────────────────────────────── */
  .title-scrim {
    position: absolute;
    top: 22%;
    left: 0;
    right: 0;
    height: 55%;
    background: radial-gradient(ellipse 75% 55% at 50% 50%,
      rgba(0,0,0,0.60) 0%,
      rgba(0,0,0,0.00) 100%
    );
    z-index: 2;
    pointer-events: none;
  }

  /* ── Left accent line ───────────────────────────────────────────── */

  /* ── Header: factjot. top-left, TOPIC top-right ────────────────── */
  .header {
    position: absolute;
    top: 62px;
    left: 62px;
    right: 62px;
    display: flex;
    align-items: center;
    z-index: 5;
  }
  .header-wordmark {
    font-family: "Instrument Serif", Georgia, serif;
    font-weight: 400;
    font-size: 30px;
    letter-spacing: -0.02em;
    color: var(--off-white);
    flex: 1 1 auto;
    white-space: nowrap;
    text-shadow: 1px 1px 0 rgba(0,0,0,0.6);
  }
  .header-wordmark .reg  { font-style: normal; }
  .header-wordmark .ital { font-style: italic; }
  .header-wordmark .dot  { color: var(--accent); }
  .header-topic {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-weight: 700;
    font-size: 22px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--off-white);
    flex: 0 0 auto;
    white-space: nowrap;
    text-shadow: 1px 1px 0 rgba(0,0,0,0.6);
  }

  /* ── Corner brackets ────────────────────────────────────────────── */
  .corners { position: absolute; inset: 0; z-index: 4; pointer-events: none; }
  .corner { position: absolute; width: 56px; height: 56px; }
  .corner::before, .corner::after {
    content: ""; position: absolute; background: var(--off-white); opacity: 0.65;
  }
  .corner::before { height: 3px; width: 100%; top: 0; left: 0; }
  .corner::after  { width:  3px; height: 100%; top: 0; left: 0; }
  .corner-tl { top: 48px;  left: 48px; }
  .corner-tr { top: 48px;  right: 48px; transform: scaleX(-1); }
  .corner-bl { bottom: 48px; left: 48px;  transform: scaleY(-1); }
  .corner-br { bottom: 48px; right: 48px; transform: scale(-1); }

  /* ── Title: centred, Instrument Serif ───────────────────────────── */
  .title {
    position: absolute;
    top: 50%;
    left: 72px;
    right: 72px;
    transform: translateY(-50%);
    z-index: 5;
    font-family: "Instrument Serif", Georgia, serif;
    font-weight: 400;
    font-size: {{ title_size }}px;
    line-height: 1.06;
    letter-spacing: -0.020em;
    color: var(--off-white);
    text-align: center;
    text-wrap: balance;
    text-shadow:
      2px 2px 0 rgba(0,0,0,0.70),
      0 4px 18px rgba(0,0,0,0.60),
      0 8px 48px rgba(0,0,0,0.40);
  }
  .title em { font-style: italic; }
  .title .accent { color: var(--accent); font-style: italic; }

</style>
</head>
<body>
<div class="stage">

  <div class="grad-top"></div>
  <div class="grad-bottom"></div>
  <div class="grad-sides"></div>
  <div class="title-scrim"></div>

  <div class="header">
    <span class="header-wordmark">
      <span class="reg">fact</span><span class="ital">jot</span><span class="dot">.</span>
    </span>
    <span class="header-topic">{{ topic }}</span>
  </div>

  <div class="corners">
    <div class="corner corner-tl"></div>
    <div class="corner corner-tr"></div>
    <div class="corner corner-bl"></div>
    <div class="corner corner-br"></div>
  </div>

  <div class="title">{{ title_html | safe }}</div>

</div>
</body>
</html>
