# factjot environment configuration
# ------------------------------------------------------------------
# Copy this file to `.env` and fill in the values you need. The file
# is gitignored. In CI, the GitHub workflow `autonomous-reel.yml`
# writes a `.env` from GitHub Secrets at run start; keep secret
# names here in sync with the workflow's heredoc block.
# ------------------------------------------------------------------

# ===== REQUIRED =====================================================

# ----- Meta / Instagram Graph API ---------------------------------
# How to get these:
#   1. Convert @factjot to a Professional account (Business or Creator) in the IG app.
#   2. Link it to a Facebook Page in Meta Business Suite.
#   3. Create a Meta Developer app at https://developers.facebook.com/apps/ (Business type).
#   4. Add the Instagram Graph API product.
#   5. Generate a long-lived access token with scopes:
#        instagram_content_publish, instagram_basic, pages_read_engagement, pages_show_list
#   6. Look up the numeric IG Account ID and Facebook Page ID via /me/accounts.
# Tokens expire every ~60 days; `pipelines/shared/refresh_token.py` extends them.
INSTAGRAM_ACCOUNT_ID=
FACEBOOK_PAGE_ID=
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
# graph.facebook.com for the Facebook-login flow (current production),
# graph.instagram.com for the Instagram-login flow (older accounts).
META_GRAPH_HOST=graph.facebook.com

# ----- Image hosting ----------------------------------------------
# Free, instant. Sign up at https://api.imgbb.com/ and paste the API key here.
IMGBB_API_KEY=
# Which host backend the publisher uses. Default `imgbb`. `tmpfiles`
# is the primary reel video host; Cloudinary is the fallback when
# tmpfiles is unavailable (used automatically for videos ≤5 MB).
IMAGE_HOST=imgbb
# Cloudinary fallback video host. Unsigned upload — cloud name and
# preset are non-sensitive. Used when tmpfiles.org is unreachable.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# ----- Anthropic Claude (autonomous agent + Haiku helpers) --------
# https://console.anthropic.com -> API Keys.
# Sonnet 4.6 runs the autonomous agent + carousel writer.
# Haiku 4.5 runs image selection, repair, hashtag generation, search expansion.
ANTHROPIC_API_KEY=
# Optional override if the workflow ever needs to pin a non-default model.
ANTHROPIC_MODEL=

# ----- ElevenLabs TTS (REQUIRED for reels) ------------------------
# https://elevenlabs.io/app/settings/api-keys
# ELEVENLABS_VOICE is the voice_id of the production reel narration.
# When TTS_BACKEND=elevenlabs (the default), the env value OVERRIDES
# the `--voice` CLI flag in make_reel.py. The named shortcuts in
# `src/render/tts_engine.py::_EL_VOICES` are only used by local CLI
# runs that pass a name instead of an id. To audit which voice is
# live, run `gh secret list ELEVENLABS_VOICE` for the secret's last-
# modified date; the value itself cannot be retrieved through gh.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE=
# `elevenlabs` (default) or `edge` (free Microsoft fallback, lower quality).
TTS_BACKEND=elevenlabs

# ===== STRONGLY RECOMMENDED =========================================

# ----- Image sources ----------------------------------------------
# Without these, the bot leans on Openverse + Wikipedia + iNaturalist + NASA + Smithsonian.
# Adding Pexels and Pixabay massively improves photo variety.
# Flickr is no longer supported (API became premium-only in 2024).
PEXELS_API_KEY=
PIXABAY_API_KEY=
SMITHSONIAN_API_KEY=
# Coverr is a stock video API. Used as a fallback footage source for reels.
COVERR_API_KEY=

# ----- Film / TV metadata (for list carousels + reel seeding) -----
# https://developer.themoviedb.org/reference/intro/getting-started
# Both API key and read-token forms are accepted; either is fine.
TMDB_API_KEY=
TMDB_READ_TOKEN=
# https://www.omdbapi.com/apikey.aspx - confidence-gated TMDB fallback.
OMDB_API_KEY=

# ----- YouTube cross-post (Shorts) --------------------------------
# Successful reels cross-post to YouTube as Shorts.
# Set up via Google Cloud Console -> OAuth client -> Desktop application
# with the youtube.upload scope. Use thefactjot@gmail.com (the brand's
# dedicated Google account), NOT a personal Google account.
# YOUTUBE_REFRESH_TOKEN is long-lived; rotate periodically.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ===== OPTIONAL ======================================================

# ----- Reel render tuning -----------------------------------------
# Visual finish on reels. Defaults in the renderer are tuned to the
# brand kit; only set these to override per-environment.
REEL_TEXTURE_FINISH=
REEL_TEXTURE_INTENSITY=
REEL_GRIT_OVERLAY_PATH=
# Minimum confidence floor for a footage clip to be selected for a
# reel beat. Lowering this admits more clips but reduces topical match.
REEL_CLIP_MIN_CONF_SCORE=

# ----- Caption credits --------------------------------------------
# Music attribution line appended to reel captions. Leave empty to skip.
MUSIC_CREDIT=

# ----- Locale -----------------------------------------------------
# Used by render timestamping and reel scheduling logic. The workflow
# overrides this to UTC at run time so logs are unambiguous in CI.
TIMEZONE=Europe/London

# ===== RUNTIME-ONLY (DO NOT SET MANUALLY) ===========================

# These are set by the workflow at run start (via inputs or step env)
# and are documented here only so anyone grepping for them finds an
# explanation rather than a dangling reference.
#
# POST_MODE   - one of {reel_morning, list_midday, reel_night}.
#               Set by `.github/workflows/autonomous-reel.yml` from
#               the cron schedule or workflow_dispatch input.
# DRY_RUN     - "true"/"false". Set from workflow_dispatch input.
#               When true, the agent composes a post but skips upload
#               and publish.
