{"quote_hash": "c0b949b3dd37daaa4ee72854921a554b2d905395c806dc7a3265113773eb33ff", "quote": "You are allowed to take up space.", "attribution": "", "post_id": "ac1da5622115e6", "ig_media_id": "18211394587333889", "ts": "2026-04-29T18:08:30.543362Z"}
{"quote_hash": "7e71e7ca6430bdb3ea6f42d1a785a968954901a541e4eb54bed85e8bb0234081", "quote": "And now we welcome the new year, full of things that have never been.", "attribution": "Rainer Maria Rilke", "post_id": "b401a141ce2832", "ig_media_id": "18079671887540791", "ts": "2026-04-29T18:34:26.660367Z"}
{"quote_hash": "508d319cdf41abd4cee498d4bdbd78292a095d5719e1ccf3a16f42898ca11100", "quote": "Quiet wins still count as wins.", "attribution": "", "post_id": "24942cfa604fb6", "ig_media_id": "18324581197280793", "ts": "2026-04-29T18:42:44.255889Z"}
{"quote_hash": "09fcff117cc4abb5aee358f2a2cce6007dfafb6c298ba0bde56095bc5414322d", "quote": "There is nothing either good or bad, but thinking makes it so.", "attribution": "William Shakespeare", "post_id": "a1b282f51ad0bb", "ig_media_id": "18117083323665596", "ts": "2026-04-29T19:09:10.366822Z"}
{"quote_hash": "53936e033e9392a69f600929847a64b8c7ed6901d285a4c6fdb90856ab0492e0", "quote": "Have patience. All things are difficult before they become easy.", "attribution": "Saadi", "post_id": "0a0961a686fafc", "ig_media_id": "18201190513351850", "ts": "2026-04-29T19:18:25.323332Z"}
{"quote_hash": "7f0dd05394b825a4d0f9963ebb78be52ae106cfa414c0a50ce5c783fb426d1a6", "quote": "The fact you cared enough to read this far means something.", "attribution": "", "post_id": "a6846ceac7c4e5", "ig_media_id": "17865332346546734", "ts": "2026-04-30T07:04:04.502252Z"}
{"quote_hash": "604886c3845610f78b0ecd22663cc57aabe54548b23c31c46d3c98019d495e8a", "quote": "Curiosity is its own reward.", "attribution": "", "post_id": "ee41c1f6bfd4fa", "ig_media_id": "18396608134159815", "ts": "2026-04-30T07:05:01.877589Z"}
{"quote_hash": "1000c2b08b5d04895fb8dcd18f769abf07bf3b8d788e032d26bb8a55b0893236", "quote": "The only way out is through.", "attribution": "Robert Frost", "post_id": "41c2a74571ef33", "ig_media_id": "17915941620164062", "ts": "2026-04-30T08:12:26.085447Z"}
{"quote_hash": "d2f950496953b831b52755aea2a5a567ddd6014409963c5d5a1fcaa1b8e80c3a", "quote": "Look up more than you scroll down.", "attribution": "", "post_id": "daf898e23152bc", "ig_media_id": "18089517920586284", "ts": "2026-04-30T08:42:31.861161Z"}
{"quote_hash": "2778a33739413a8881505f160f4c73cb08f69ede5e3e3718e36c1e38d8b3f115", "quote": "Small kindnesses still count.", "attribution": "", "post_id": "65380c2214c2aa", "ig_media_id": "18082590011431895", "ts": "2026-04-30T17:12:35.857272Z"}
{"quote_hash": "585f414524b658cb51252f51ffa9de018426776a39f653ddafa7d9f17460d6c8", "quote": "Be the change you wish to see.", "attribution": "Mahatma Gandhi (often attributed)", "post_id": "63475ed0a8ceee", "ig_media_id": "18080306243560838", "ts": "2026-04-30T18:21:59.300468Z"}
{"quote_hash": "83967088bf91d3c9974d8aecf5a55649b998ad3d2d7fb77765f3f73241611802", "quote": "Do small things with great love.", "attribution": "Mother Teresa", "post_id": "05acce0896ef27", "ig_media_id": "18117730324674287", "ts": "2026-04-30T18:52:51.894382Z"}
{"quote_hash": "095814ffcbefbd211fb7407bd8d117dceffafa435847e6265287d420a234a251", "quote": "Be kind, for everyone you meet is fighting a hard battle.", "attribution": "Ian Maclaren", "post_id": "fdb5866b072645", "ig_media_id": "18098417525120935", "ts": "2026-05-01T08:05:58.678669Z"}
